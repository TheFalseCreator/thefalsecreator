<div class="scene-shell" aria-label="Abstract impossible architectural structure in a dark void">
  <canvas id="architecture-scene" aria-hidden="true"></canvas>
  <div class="scene-grain" aria-hidden="true"></div>
  <div class="scene-caption"><span>FIG. 001</span><span>THE UNFINISHED MONUMENT</span></div>
</div>

<script>
  import * as THREE from 'three';

  const canvas = document.querySelector<HTMLCanvasElement>('#architecture-scene');
  const shell = canvas?.parentElement;
  if (canvas && shell) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#08090b');
    scene.fog = new THREE.FogExp2('#08090b', 0.045);

    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
    camera.position.set(7.5, 5.4, 10.5);
    camera.lookAt(0, 0.8, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: 'low-power' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;

    const monument = new THREE.Group();
    scene.add(monument);

    const stone = new THREE.MeshStandardMaterial({ color: '#77736b', roughness: 0.48, metalness: 0.22 });
    const darkStone = new THREE.MeshStandardMaterial({ color: '#25272a', roughness: 0.65, metalness: 0.18 });
    const warmEdge = new THREE.MeshStandardMaterial({ color: '#b9a783', roughness: 0.32, metalness: 0.5, emissive: '#241b0d', emissiveIntensity: 0.22 });

    function block(w: number, h: number, d: number, material: THREE.Material, x: number, y: number, z: number, ry = 0) {
      const geometry = new THREE.BoxGeometry(w, h, d);
      const mesh = new THREE.Mesh(geometry, material);
      mesh.position.set(x, y, z);
      mesh.rotation.y = ry;
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      monument.add(mesh);
      return mesh;
    }

    // A deliberately impossible, Escher-like stack of offset architectural planes.
    block(2.2, 0.24, 2.1, darkStone, 0, -0.65, 0);
    block(1.25, 3.7, 0.24, stone, -0.65, 1.15, -0.55, -0.12);
    block(0.24, 2.7, 1.85, warmEdge, 0.55, 1.05, -0.1, 0.08);
    block(2.45, 0.22, 0.3, stone, 0.45, 2.45, -0.65, -0.16);
    block(0.28, 2.35, 1.9, darkStone, 1.15, 1.05, 0.1, 0.2);
    block(1.95, 0.2, 0.28, warmEdge, 0.15, 0.05, 0.9, -0.18);
    block(0.25, 2.65, 0.25, stone, -0.55, 0.75, 0.85, 0.08);
    block(1.45, 0.18, 0.25, darkStone, -0.05, 1.95, 0.82, 0.12);

    // Thin floating lintel: a visual break that makes the structure feel physically impossible.
    block(2.25, 0.12, 0.18, warmEdge, 0.15, 3.0, -0.2, -0.22);

    const floor = new THREE.Mesh(
      new THREE.CircleGeometry(9, 80),
      new THREE.MeshStandardMaterial({ color: '#0d0f12', roughness: 0.9, metalness: 0.1 })
    );
    floor.rotation.x = -Math.PI / 2;
    floor.position.y = -0.82;
    scene.add(floor);

    scene.add(new THREE.AmbientLight('#8e929a', 0.75));
    const key = new THREE.DirectionalLight('#f0dfbc', 4.2);
    key.position.set(4, 7, 5);
    scene.add(key);
    const rim = new THREE.PointLight('#9babc2', 24, 18);
    rim.position.set(-4, 3, -4);
    scene.add(rim);
    const low = new THREE.PointLight('#b18d55', 8, 12);
    low.position.set(2, -0.1, 3);
    scene.add(low);

    let width = 0;
    let height = 0;
    const resize = () => {
      const rect = shell.getBoundingClientRect();
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      camera.aspect = width / height;
      camera.position.z = width < 600 ? 14.5 : 10.5;
      camera.position.y = width < 600 ? 6.0 : 5.4;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
    };
    const observer = new ResizeObserver(resize);
    observer.observe(shell);
    resize();

    let frame = 0;
    const start = performance.now();
    const animate = (now: number) => {
      frame = requestAnimationFrame(animate);
      const elapsed = (now - start) / 1000;
      const reveal = reducedMotion ? 1 : Math.min(1, elapsed / 2.8);
      monument.scale.setScalar(0.86 + reveal * 0.14);
      monument.position.y = reducedMotion ? 0 : -0.22 + reveal * 0.22;
      if (!reducedMotion) {
        monument.rotation.y = Math.sin(elapsed * 0.16) * 0.07;
        camera.position.x = 7.5 + Math.sin(elapsed * 0.12) * 0.34;
        camera.lookAt(0, 0.8, 0);
      }
      renderer.render(scene, camera);
    };
    frame = requestAnimationFrame(animate);

    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      renderer.dispose();
      scene.traverse((obj) => {
        if (obj instanceof THREE.Mesh) {
          obj.geometry.dispose();
          const materials = Array.isArray(obj.material) ? obj.material : [obj.material];
          materials.forEach((mat) => mat.dispose());
        }
      });
    }, { once: true });
  }
</script>

<style>
  .scene-shell { position: absolute; inset: 0; overflow: hidden; background: #08090b; }
  canvas { display: block; width: 100%; height: 100%; }
  .scene-grain {
    position: absolute; inset: 0; pointer-events: none; opacity: .13; mix-blend-mode: screen;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.2'/%3E%3C/svg%3E");
  }
  .scene-caption { position: absolute; right: clamp(1.2rem, 4vw, 4rem); bottom: 1.4rem; left: clamp(1.2rem, 4vw, 4rem); display: flex; justify-content: space-between; gap: 1rem; color: #aaa69c; font: 10px 'DM Mono', monospace; letter-spacing: .12em; }
</style>
