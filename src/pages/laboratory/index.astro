<style>
.page{max-width:1000px;min-height:100vh;margin:auto;padding:3rem 1.5rem 8rem}.back,.eyebrow,.status{font:10px 'DM Mono',monospace;letter-spacing:.12em;color:#a7a49c}.eyebrow{margin-top:8rem}h1{font-size:clamp(4rem,12vw,9rem);letter-spacing:-.08em;font-weight:500;line-height:.9;margin:2rem 0}.lead{max-width:550px;font-size:1.4rem;line-height:1.6;color:#b6b3ab}.status{margin:3rem 0 2rem;padding:1.2rem;border:1px solid #ffffff22;display:flex;align-items:center;gap:.7rem}.dot{width:6px;height:6px;border-radius:50%;background:#d6c8a8}
