---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — The False Creator">
  <main class="page"><a href="/" class="back">← THE FALSE CREATOR</a><p class="eyebrow">CONTACT / TRANSMISSION</p><h1>Leave a<br />signal.</h1><p class="lead">For thoughtful conversations, collaborations, and experiments worth exploring.</p><p>Contact details will be added here when you're ready to publish them.</p><a href="/" class="back">RETURN TO THE BEGINNING ↗</a></main>
</BaseLayout>
<style>
.page{max-width:900px;min-height:100vh;margin:auto;padding:3rem 1.5rem 8rem}.back,.eyebrow{font:10px 'DM Mono',monospace;letter-spacing:.12em;color:#a7a49c}.eyebrow{margin-top:8rem}h1{font-size:clamp(4rem,12vw,9rem);letter-spacing:-.08em;line-height:.9;font-weight:500;margin:2rem 0}.lead{font-size:1.4rem;color:#d6c8a8}p:not(.eyebrow){max-width:650px;color:#b6b3ab;line-height:1.9}
</style>
