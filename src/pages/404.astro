---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Lost in the Void — The False Creator">
  <main>
    <p>404 / UNKNOWN TERRITORY</p>
    <h1>This world<br />has not been made.</h1>
    <a href="/">RETURN TO THE BEGINNING ↗</a>
  </main>
</BaseLayout>
<style>
  main { min-height: 100vh; padding: 15vh 8vw; background: radial-gradient(ellipse at 75% 30%, #25221b, #08090b 55%); }
  p,a { color: #b6ad9a; font: 10px 'DM Mono',monospace; letter-spacing: .12em; }
  h1 { font-size: clamp(3.5rem, 10vw, 8rem); line-height: .95; letter-spacing: -.07em; font-weight: 500; }
</style>
