---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImpossibleArchitecture from '../components/ImpossibleArchitecture.astro';
const worlds = [
  { number: '01', title: 'Philosophy', description: 'Ideas, paradoxes, and the edges of certainty.', href: '/philosophy/' },
  { number: '02', title: 'Creations', description: 'Things made real through curiosity and work.', href: '/creations/' },
  { number: '03', title: 'The Laboratory', description: 'Experiments that have not yet found their final form.', href: '/laboratory/' },
  { number: '04', title: 'The Archive', description: 'Fragments, essays, notes, and discoveries.', href: '/archive/' },
];
---
<BaseLayout title="The False Creator — Enter the Unfinished" description="A world of ideas, paradoxes, and things not yet made.">
  <header class="topbar">
    <a class="wordmark" href="/" aria-label="The False Creator home">THE FALSE<br />CREATOR<span>®</span></a>
    <a class="menu-link" href="#worlds">EXPLORE <span>↘</span></a>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <ImpossibleArchitecture />
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow"><span class="live-dot"></span> AN EXPERIMENT IN CREATION</p>
        <h1 id="hero-title">WHAT IF THE<br />IMPOSSIBLE IS<br /><em>ONLY UNCREATED?</em></h1>
        <p class="hero-copy">A world of ideas, paradoxes, and things not yet made.</p>
        <a class="enter-link" href="#thesis"><span class="enter-icon">↓</span> ENTER THE WORLD</a>
      </div>
      <div class="hero-index"><span>INDEPENDENT THOUGHT / VOL. 001</span><span>28° 36' N — UNKNOWN</span></div>
    </section>

    <section class="thesis section-wrap" id="thesis">
      <div class="section-label"><span>01 / THE THESIS</span><span>A WORK IN PROGRESS</span></div>
      <div class="thesis-grid">
        <h2>The world<br />is <em>not finished.</em></h2>
        <div class="thesis-copy">
          <p>Every boundary begins as an idea. Some become laws, some become habits, and some are mistaken for the edge of what is possible.</p>
          <p>This is a place to question those edges — to think carefully, build experimentally, and leave room for what has not yet been imagined.</p>
          <a class="text-link" href="/manifesto/">READ THE MANIFESTO <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="worlds section-wrap" id="worlds">
      <div class="section-label"><span>02 / CHOOSE A DOOR</span><span>FOUR OPEN WORLDS</span></div>
      <div class="world-grid">
        {worlds.map((world) => (
          <a class="world-card" href={world.href}>
            <div class="world-card-top"><span>{world.number}</span><span>↗</span></div>
            <div class="card-glyph" aria-hidden="true">{world.number === '01' ? '◇' : world.number === '02' ? '⌘' : world.number === '03' ? '∿' : '⌁'}</div>
            <h3>{world.title}</h3>
            <p>{world.description}</p>
            <span class="card-bottom">ENTER WORLD <span>→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="object-section">
      <div class="object-copy">
        <p class="section-kicker">03 / THE UNFINISHED OBJECT</p>
        <h2>Not every<br />structure needs<br />to <em>make sense.</em></h2>
        <p>A monument to the ideas that do not fit neatly into the world as it is.</p>
        <a class="text-link" href="/laboratory/">EXPLORE THE LABORATORY <span>↗</span></a>
      </div>
      <div class="object-mark" aria-hidden="true"><span>∅</span><small>FORM / 001<br />STATE / UNRESOLVED</small></div>
    </section>

    <section class="closing section-wrap">
      <p class="eyebrow">THERE IS MORE BEYOND THE KNOWN</p>
      <h2>Nothing here<br />is <em>finished.</em></h2>
      <a class="enter-link" href="/archive/"><span class="enter-icon">↗</span> OPEN THE ARCHIVE</a>
    </section>
  </main>

  <footer class="footer">
    <a class="wordmark" href="/">THE FALSE<br />CREATOR<span>®</span></a>
    <span>AN EXPERIMENT IN BECOMING.</span>
    <a href="/about/">ABOUT ↗</a>
    <span>© {new Date().getFullYear()} THE FALSE CREATOR</span>
  </footer>
</BaseLayout>

<style>
  .topbar { position: absolute; z-index: 5; top: 0; left: 0; width: 100%; padding: 1.5rem clamp(1.2rem, 4vw, 4rem); display: flex; align-items: center; justify-content: space-between; }
  .wordmark { position: relative; display: inline-block; font-size: .78rem; line-height: 1.02; letter-spacing: .08em; font-weight: 700; }
  .wordmark span { position: absolute; top: 0; right: -1rem; font: 9px 'DM Mono', monospace; }
  .menu-link, .eyebrow, .section-label, .hero-index, .section-kicker, .text-link, .enter-link, .card-bottom, .footer > span, .footer > a:not(.wordmark) { font: 10px 'DM Mono', monospace; letter-spacing: .12em; }
  .menu-link span { color: var(--antique); margin-left: .6rem; }
  .hero { min-height: min(900px, 100svh); min-height: max(720px, 100svh); position: relative; overflow: hidden; display: flex; align-items: center; padding: 8rem clamp(1.2rem, 9vw, 9rem) 7rem; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,9,11,.96) 0%, rgba(8,9,11,.82) 35%, rgba(8,9,11,.12) 75%), linear-gradient(0deg, #08090b 0%, transparent 28%, transparent 80%, rgba(8,9,11,.38)); pointer-events: none; }
  .hero-content { position: relative; z-index: 2; max-width: 760px; padding-top: 2rem; }
  .eyebrow { color: var(--muted); display: flex; align-items: center; gap: .7rem; }
  .live-dot { display: inline-block; width: 5px; height: 5px; background: var(--antique); border-radius: 50%; box-shadow: 0 0 12px #d6c8a877; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin: 2rem 0 1.6rem; font-size: clamp(3.15rem, 7.6vw, 7.6rem); line-height: .91; letter-spacing: -.075em; font-weight: 500; }
  h1 em, h2 em { color: var(--antique); font-style: normal; }
  .hero-copy { max-width: 340px; color: #b6b3ab; font-size: 1rem; line-height: 1.7; }
  .enter-link { display: inline-flex; align-items: center; gap: .85rem; margin-top: 1.4rem; padding: .65rem 0; }
  .enter-icon { width: 32px; height: 32px; border: 1px solid #bdb09a66; border-radius: 50%; display: inline-grid; place-items: center; color: var(--antique); font-size: 15px; transition: background .25s, color .25s, transform .25s; }
  .enter-link:hover .enter-icon { background: var(--antique); color: var(--void); transform: translateY(2px); }
  .hero-index { position: absolute; z-index: 2; bottom: 1.6rem; left: clamp(1.2rem, 4vw, 4rem); right: clamp(1.2rem, 4vw, 4rem); display: flex; justify-content: space-between; color: #8c8981; font-size: 9px; }
  .section-wrap { padding: clamp(5rem, 10vw, 10rem) clamp(1.2rem, 9vw, 9rem); }
  .section-label { color: var(--muted); display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .thesis-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 4rem; padding-top: 3.5rem; align-items: end; }
  h2 { font-size: clamp(3rem, 7vw, 6.8rem); font-weight: 500; line-height: .95; letter-spacing: -.07em; margin-bottom: 0; }
  .thesis-copy { max-width: 470px; color: #b6b3ab; line-height: 1.8; font-size: .98rem; }
  .text-link { display: inline-flex; gap: 1.4rem; margin-top: 1rem; padding-bottom: .7rem; border-bottom: 1px solid #d6c8a866; color: var(--bone); }
  .text-link span { color: var(--antique); }
  .worlds { padding-top: 2rem; }
  .world-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin-top: 2rem; background: var(--line); border: 1px solid var(--line); }
  .world-card { min-height: 285px; display: flex; flex-direction: column; padding: 1.2rem; background: var(--void); transition: background .3s; }
  .world-card:hover { background: #15161a; }
  .world-card-top { display: flex; justify-content: space-between; color: var(--muted); font: 10px 'DM Mono', monospace; }
  .world-card-top span:last-child { color: var(--antique); }
  .card-glyph { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 3rem; font-weight: 300; color: #9e9072; opacity: .8; }
  .world-card h3 { font-size: 1.25rem; font-weight: 500; margin-bottom: .55rem; }
  .world-card p { color: var(--muted); font-size: .85rem; line-height: 1.55; min-height: 3.9em; }
  .card-bottom { display: flex; justify-content: space-between; margin-top: .7rem; color: #a5a198; font-size: 9px; }
  .card-bottom span { color: var(--antique); }
  .object-section { position: relative; overflow: hidden; min-height: 560px; display: flex; align-items: center; padding: 6rem clamp(1.2rem, 9vw, 9rem); background: radial-gradient(ellipse at 75% 48%, #28231a 0%, #111216 28%, #08090b 65%); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .object-copy { position: relative; z-index: 1; max-width: 570px; }
  .section-kicker { color: var(--muted); margin-bottom: 2rem; }
  .object-copy h2 { font-size: clamp(3rem, 6vw, 5.8rem); }
  .object-copy > p:not(.section-kicker) { max-width: 310px; color: var(--muted); line-height: 1.7; margin-top: 1.5rem; }
  .object-mark { position: absolute; right: 10%; top: 50%; transform: translateY(-50%); width: clamp(180px, 30vw, 400px); aspect-ratio: 1; border: 1px solid #b9a78325; border-radius: 50%; display: grid; place-items: center; color: #b9a7831f; }
  .object-mark::before, .object-mark::after { content: ''; position: absolute; inset: 12%; border: 1px solid #b9a78330; border-radius: 50%; transform: rotateX(68deg) rotateZ(28deg); }
  .object-mark::after { transform: rotateX(68deg) rotateZ(-38deg); }
  .object-mark span { font-size: clamp(6rem, 17vw, 15rem); font-weight: 300; }
  .object-mark small { position: absolute; bottom: 15%; right: 0; color: #a49a85; font: 9px/1.8 'DM Mono', monospace; letter-spacing: .1em; }
  .closing { min-height: 500px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .closing h2 { font-size: clamp(4rem, 10vw, 9rem); }
  .footer { border-top: 1px solid var(--line); padding: 2rem clamp(1.2rem, 4vw, 4rem); display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; color: var(--muted); }
  .footer .wordmark { color: var(--bone); }
  .footer > span { font-size: 9px; }
  @media (max-width: 800px) {
    .hero { min-height: 790px; align-items: flex-end; padding-top: 10rem; padding-bottom: 9rem; }
    .hero-shade { background: linear-gradient(0deg, rgba(8,9,11,.98) 0%, rgba(8,9,11,.82) 40%, rgba(8,9,11,.12) 100%); }
    .hero-content { padding-top: 0; }
    h1 { font-size: clamp(3.1rem, 11vw, 5.8rem); }
    .thesis-grid { grid-template-columns: 1fr; gap: 2rem; }
    .world-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .world-card { min-height: 260px; }
    .object-mark { right: -15%; opacity: .6; }
    .footer { flex-wrap: wrap; }
    .footer > span:nth-of-type(1) { display: none; }
  }
  @media (max-width: 420px) {
    .hero-index span:last-child { display: none; }
    .world-card { padding: .9rem; min-height: 250px; }
    .world-card h3 { font-size: 1.08rem; }
    .world-card p { font-size: .8rem; }
  }
</style>
